{
  "name": "@goya24/messenger",
  "version": "0.1.0",
  "description": "Load and control the goya24 support messenger from any JavaScript page: open it, identify the signed-in customer, listen for unread replies.",
  "license": "MIT",
  "author": "Goya24",
  "homepage": "https://github.com/Goya-24/goya24-js/tree/main/packages/messenger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goya-24/goya24-js.git",
    "directory": "packages/messenger"
  },
  "bugs": {
    "url": "https://github.com/Goya-24/goya24-js/issues"
  },
  "keywords": [
    "goya24",
    "customer-support",
    "chat-widget",
    "messenger",
    "live-chat",
    "ai-agent",
    "persian",
    "rtl"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
