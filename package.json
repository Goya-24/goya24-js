{
  "name": "goya24-js",
  "private": true,
  "description": "Official JavaScript SDK for the goya24 messenger: a framework-free core plus React, Vue and Nuxt wrappers.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "size": "size-limit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "examples:build": "pnpm -r --filter \"./examples/*\" run build",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "api": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "publish:check": "pnpm -r --filter \"./packages/*\" exec publint --strict && pnpm -r --filter \"./packages/*\" exec attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^13.0.3",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.13"
  },
  "size-limit": [
    {
      "name": "@goya24/messenger (esm, gzip)",
      "path": "packages/messenger/dist/index.js",
      "limit": "2.5 kB"
    },
    {
      "name": "@goya24/react (esm, gzip)",
      "path": "packages/react/dist/index.js",
      "limit": "2.5 kB",
      "ignore": [
        "react",
        "@goya24/messenger"
      ]
    },
    {
      "name": "@goya24/vue (esm, gzip)",
      "path": "packages/vue/dist/index.js",
      "limit": "2.5 kB",
      "ignore": [
        "vue",
        "@goya24/messenger"
      ]
    }
  ]
}
